node_modules
.pnpm-store
npm-debug.log
.next
.git
data
e2e/.tmp
test-results
playwright-report
.gitignore
README.md
# Every real env file. `COPY . .` copies the whole build context, so anything
# matched here is the difference between a config file on disk and a credential
# baked into a published image layer — where deleting it later does not remove
# it from the layer it was added in.
#
# Only .env.local was excluded before, which left .env itself being copied in.
.env
.env.*
!.env.example
!.env.staging.example

# Local database dumps and backups, which contain customer data.
*.sql
*.dump

# Internal engineering documentation. It is not needed at runtime, so it stays
# out of the published image layers.
ARCHITECTURE.md
TESTING-GUIDE.md
ENV-VARS.md

# Tests and fixtures. The runtime never loads them, and their placeholder
# credentials trip every secret scanner a self-hoster points at the image.
tests
e2e
playwright.config.ts
vitest.config.ts

# Compose files and CI config describe how to run the image; they are not part
# of it.
docker-compose*.yml
.github

