# Copy to .env and fill in what you need. See the self-hosting guide for the
# full walkthrough: https://replywise.example.com/docs/quickstart-self-host
# Complete reference for every variable: https://replywise.example.com/docs/reference/environment-variables

# Core (required)
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=
ENCRYPTION_KEY=

# Auth (required — sign-in is Google-only; there is no GitHub or Discord OAuth provider)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Bot
BOT_SECRET=
BOT_TARGET_URL=

# Pooled Postgres providers (a provider's -pooler endpoint, PgBouncer) — non-pooled connection
# string for LISTEN/NOTIFY. Falls back to DATABASE_URL when unset.
DIRECT_DATABASE_URL=

# Networking (optional)
TRUST_PROXY_HOPS=1
ORIGIN_VERIFY_SECRET=


# Discord (optional — ingest channel)
DISCORD_APPLICATION_ID=
DISCORD_CHANNEL_IDS=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_TOKEN=

# Slack (optional — ingest channel)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_POLL_INTERVAL_SECONDS=60
SLACK_SIGNING_SECRET=

# AI providers (optional — platform-wide fallback; OPENAI_API_KEY is the only
# one used before an org configures its own key in Settings → AI Model)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Firecrawl (optional — URL KB ingest)
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=

# Allow knowledge-base URL imports from private network addresses (optional — self-hosted only)
ALLOW_PRIVATE_OUTBOUND_URLS=

# Resend (optional — email alerts + email ingest channel)
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
