{
  "name": "replywise",
  "version": "0.6.7",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "fumadocs-mdx",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "bot": "tsx watch bot/index.ts",
    "bot:start": "tsx bot/index.ts",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm bot\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:typecheck": "tsc --noEmit -p e2e/tsconfig.json",
    "test:e2e:ui": "playwright test --ui",
    "test:server": "next start -p 3100",
    "docker:preview": "docker compose -f docker-compose.prod.yml down && docker compose -f docker-compose.prod.yml up -d --build app",
    "docs:generate-api": "node scripts/generate-api-reference.mjs",
    "llms:sync": "node scripts/sync-llms-txt.mjs",
    "llms:check": "node scripts/sync-llms-txt.mjs --check",
    "support:eval": "tsx scripts/support-eval.ts",
    "github:backfill-threads": "tsx scripts/backfill-github-comment-threads.ts",
    "docs:seed": "tsx scripts/docs-demo/seed.ts",
    "docs:session": "tsx scripts/docs-demo/session.ts",
    "docs:shots": "tsx scripts/docs-demo/capture.ts",
    "lint:fix": "oxlint --fix",
    "verify:stripe-prices": "tsx scripts/verify-stripe-prices.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.41",
    "@ai-sdk/anthropic": "^1.2.11",
    "@ai-sdk/google": "^1.2.18",
    "@ai-sdk/groq": "^1.2.9",
    "@ai-sdk/mistral": "^1.2.8",
    "@ai-sdk/openai": "^1.3.22",
    "@copilotkit/react-core": "1.10.6",
    "@copilotkit/runtime": "1.10.6",
    "@mastra/core": "^0.9.3",
    "@mastra/memory": "^0.3.3",
    "@mastra/pg": "^0.3.3",
    "@mendable/firecrawl-js": "^1.25.5",
    "@octokit/app": "^16.0.1",
    "@octokit/rest": "^22.0.0",
    "@sentry/nextjs": "^10.32.1",
    "@stripe/react-stripe-js": "^4.0.2",
    "@stripe/stripe-js": "^7.9.0",
    "ai": "^4.3.15",
    "csv-parse": "^5.6.0",
    "discord.js": "^14.19.3",
    "drizzle-orm": "^0.41.0",
    "fumadocs-core": "^15.8.5",
    "fumadocs-mdx": "^12.0.3",
    "fumadocs-openapi": "^9.5.1",
    "fumadocs-ui": "^15.8.5",
    "google-auth-library": "^10.5.0",
    "lucide-react": "^0.488.0",
    "mammoth": "^1.9.1",
    "mermaid": "11.12.0",
    "next": "15.3.0",
    "next-auth": "5.0.0-beta.25",
    "pdf-parse": "^1.1.1",
    "postgres": "^3.4.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^4.2.0",
    "stripe": "^18.5.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^3.1.1",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.6",
    "esbuild": "^0.25.2",
    "happy-dom": "^17.4.4",
    "oxlint": "0.16.6",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "vite": "^6.2.6",
    "vitest": "^3.1.1"
  }
}
